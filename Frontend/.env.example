# Backend used by the Vite dev proxy (server side only)
BACKEND_URL=http://localhost:3000

# Base path the browser calls. "/api" uses the dev proxy above.
# For a deployed build point this at the real backend origin.
VITE_API_BASE_URL=/api

# Leave empty to use the same origin (proxied /socket.io in dev).
VITE_SOCKET_URL=
